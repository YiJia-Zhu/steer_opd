+def validate_records(requests, records, *, model=None, content_id=None):
+    groups = validate_requests(requests)
+    if len(records) != len(requests):
+        raise ValueError('Incomplete four-rollout extraction batch')
+    saved = {}
+    for row in records:
+        if row['key'] in saved:
+            raise ValueError('Duplicate extraction result key')
+        saved[row['key']] = row
+    unique = {}
+    for qid, slots in groups.items():
+        tokens = set()
+        for request in slots.values():
+            row = saved.get(request['key'])
+            if row is None or any(row.get(k) != v for k, v in request.items()):
+                raise ValueError('Extraction result differs from its question, slot, seed or prompt')
+            if (row.get('steering') is not False or row.get('seed_policy') != POLICY
+                    or row.get('sampling_seed') != request['seed']):
+                raise ValueError('Extraction must use unsteered, explicitly seeded student requests')
+            if model is not None and row.get('model') != model:
+                raise ValueError('Extraction student checkpoint changed')
+            if content_id is not None and row.get('model_content_id') != content_id:
+                raise ValueError('Extraction student weights changed')
+            tokens.add(tuple(row['token_ids']))
+        unique[qid] = len(tokens)
+    if all(n == 1 for n in unique.values()):
+        raise ValueError('All questions have identical four-way rollouts; check per-request seed propagation')
+    return {'policy': POLICY, 'question_count': len(groups), 'trajectories': len(requests),
+        'unique_responses_per_question': dict(Counter(unique.values())), 'unique_counts': unique}
+
+
+def aggregate_pools(pooled, layers):
+    """Four equal-weight FP32 answer pools first, then subtract the reference."""
+    result = {}
+    for qid, record in pooled.items():
+        if not record['usable']:
+            result[qid] = record
+            continue
+        grouped = {}
+        for layer in layers:
+            values = record['layers'][str(layer)]
+            if len(values['pools']) != 5 or len(values['norms']) != 5:
+                raise ValueError('Need four student answer pools and one teacher reference pool')
+            pools = [p.float() for p in values['pools']]
+            if (any(p.ndim != 1 or p.shape != pools[0].shape or not torch.isfinite(p).all() for p in pools)
+                    or any(n.numel() == 0 or not torch.isfinite(n).all() for n in values['norms'])):
+                raise ValueError('Malformed or nonfinite teacher-space answer pools')
+            grouped[str(layer)] = {'pools': [torch.stack(pools[:4]).mean(0), pools[4]],
+                'norms': values['norms']}
+        result[qid] = {**record, 'layers': grouped}
+    return result
