+"""Four student extraction trajectories per question, separate from scoring text."""
+from collections import Counter, defaultdict
+
+import torch
+
+from steer_opd.resumable_core import digest
+
+SEEDS = (42, 43, 44, 45)
+POLICY = 'sv_per_question_rollout_slot_42to45_v1'
+VERSION = 'teacher_space_student_four_answer_mean_minus_reference_v1'
+AGGREGATION = 'mean_of_four_independent_answer_pools_minus_teacher_reference'
+
+
+def enabled(cfg):
+    count = cfg.get('sv_rollout_count', 1)
+    if type(count) is not int or count not in (1, 4):
+        raise ValueError('SV extraction supports the historical single answer or exactly four rollouts')
+    return count == 4
+
+
+def direction_version(cfg, role='teacher'):
+    from steer_opd.method_config import DIRECTION_VERSIONS, reader_direction
+    return VERSION if role == 'teacher' and enabled(cfg) else DIRECTION_VERSIONS[reader_direction(role)]
+
+
+def validate_reader_config(cfg, role):
+    from steer_opd.method_config import DIRECTION_VERSION
+    k4=enabled(cfg)
+    primary=cfg.get('matrix_protocol')=='st_2x2x2x2_v1'
+    if k4 or primary:
+        if (role!='teacher' or cfg.get('direction')!='S-T'
+                or cfg.get('direction_version')!=direction_version(cfg,'teacher')):
+            raise ValueError('New extraction requires teacher-space S-T with the declared rollout protocol')
+    elif cfg.get('direction')!='T-S' or cfg.get('direction_version')!=DIRECTION_VERSION:
+        raise ValueError('Expected the frozen historical T-S reader protocol')
+    return k4
+
+
+def requests_for(questions, encode_prompt):
+    ids = [q['id'] for q in questions]
+    if not ids or len(set(ids)) != len(ids):
+        raise ValueError('Extraction requires distinct question IDs')
+    requests = []
+    for q in questions:
+        prompt = list(encode_prompt(q))
+        if not prompt:
+            raise ValueError('Empty extraction prompt')
+        for slot, seed in enumerate(SEEDS):
+            requests.append({'id': q['id'], 'key': 'sv_' + digest([q['id'], slot]),
+                'question': q['question'], 'answer': q['answer'], 'rollout_slot': slot,
+                'seed': seed, 'prompt_token_ids': prompt})
+    validate_requests(requests)
+    return requests
+
+
+def validate_requests(requests):
+    grouped = defaultdict(dict)
+    keys = set()
+    for request in requests:
+        slot = request.get('rollout_slot')
+        if (type(slot) is not int or slot not in range(4)
+                or type(request.get('seed')) is not int or request['seed'] != SEEDS[slot]):
+            raise ValueError('Each rollout slot must explicitly use seed42/43/44/45')
+        if slot in grouped[request['id']] or request['key'] in keys:
+            raise ValueError('Duplicate extraction question/slot or response key')
+        grouped[request['id']][slot] = request
+        keys.add(request['key'])
+    if not grouped or any(set(slots) != set(range(4)) for slots in grouped.values()):
+        raise ValueError('Every question requires exactly four extraction rollout slots')
+    for slots in grouped.values():
+        first = slots[0]
+        if any(any(row[field] != first[field] for field in ('question', 'answer', 'prompt_token_ids'))
+               for row in slots.values()):
+            raise ValueError('Rollout slots must belong to the same question and prompt')
+    return grouped
+
+
+def sampling_params(job, requests, factory):
+    """Assign each seed before worker dispatch, independent of request ordering."""
+    validate_requests(requests)
+    from steer_opd.generation_policy import presence_penalty
+    params = [factory(n=1, seed=r['seed'], temperature=job['temperature'], top_p=job['top_p'],
+        top_k=-1, presence_penalty=presence_penalty(job, require_explicit=True),
+        max_tokens=job['max_tokens'], stop_token_ids=job.get('stop_token_ids', [])) for r in requests]
+    if any(p.seed != r['seed'] or p.n != 1 for p, r in zip(params, requests)):
