+"""Exactly the lower half of valid native teacher positions, ranked per question."""
+import math
+
+from steer_opd.resumable_core import digest
+from steer_opd.static_masks import freeze_static_mask
+
+POLICY = 'bottom_half_native_teacher_positions_overlap_stable_v1'
+
+
+def bottom_half_mask(row, metrics, plan, native_length, identity):
+    values = metrics['overlap']
+    alignment = [bool(v) for v in metrics['alignment_mask']]
+    result = freeze_static_mask(row, values, 0., identity, alignment_mask=alignment,
+                               source_metrics={m: metrics[m] for m in ('overlap','P_overlap')})
+    eligible = {}
+    for unit in plan['units']:
+        if not unit['valid']:
+            continue
+        a,b = unit['ranges']['student'];c,d = unit['ranges']['teacher']
+        if not (0 <= a < b <= len(values) and 0 <= c < d <= native_length):
+            raise ValueError('Mask alignment exceeds the scoring trajectory')
+        score = float(values[a])
+        if not math.isfinite(score) or not all(alignment[a:b]):
+            raise ValueError('Cannot rank an invalid common span')
+        for position in range(c,d):
+            if position in eligible:raise ValueError('Teacher prediction belongs to multiple spans')
+            eligible[position] = score
+    selected = sorted(eligible,key=lambda position:(eligible[position],position))[:len(eligible)//2]
+    native = [False]*native_length
+    for position in selected:native[position] = True
+    mapped = [False]*len(row['token_ids'])
+    for unit in plan['units']:
+        if unit['valid']:
+            a,b=unit['ranges']['student'];c,d=unit['ranges']['teacher']
+            mapped[a:b]=[any(native[c:d])]*(b-a)
+    result.update(mask_kind='static_overlap',mask_policy=POLICY,comparison='rank_then_native_position',
+        fraction=.5,threshold=None,requested_mask=mapped,native_requested_mask=native,
+        eligible_native_positions=len(eligible),selected_native_positions=len(selected),
+        tie_break='ascending_native_prediction_position',metric_position_role='student',
+        injection_position_role='teacher',mapped_mask_semantics='any_selected_teacher_position_in_shared_span')
+    result.pop('mask_id')
+    result['mask_id']=digest(result)
+    return result
