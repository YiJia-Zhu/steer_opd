+#!/usr/bin/env python3
+"""Run the authorized shared-bank 16-case S-T study outside the live checkout."""
+import argparse
+import fcntl
+import os
+from pathlib import Path
+import signal
+import subprocess
+import sys
+import time
+
+from steer_opd.checkpoint_identity import checkpoint_content_id
+from steer_opd.compass_campaign import frozen_json
+from steer_opd.compass_job import model_path
+from steer_opd.direction_bank import file_sha256
+from steer_opd.experiment_runtime import Progress,child_environment,source_revision,timestamp
+from steer_opd.matrix16 import (GROUPS,cases,group_config,generation_job,assemble_extraction,
+    prepare_banks,score_group,matrix_summary,upstream,freeze_common_questions)
+from steer_opd.resumable_core import ROOT,atomic_json,digest,read_json
+from steer_opd.source_bridge import SourceBridge
+from steer_opd.stage_io import project,layout_paths
+
+
+def make_spec(authorization):
+    value=read_json(authorization)
+    pool=value['allowed_gpu_pool']
+    if (not pool or len(set(pool))!=len(pool) or {2,3}.intersection(pool)
+            or set(pool)-{0,1,4,5,6,7}):raise ValueError('Matrix GPU pool must exclude physical GPUs 2 and 3')
+    if value.get('authorized_to_launch') is not True:raise ValueError('Matrix launch authorization is absent')
+    original=Path(value['original_root']).resolve();source=read_json(original/value['source_config'])
+    if (source['question_count']!=1024 or source['teacher_layers']!=[29] or source['alpha']!=.1
+            or source['operator']!='slerp' or source['scheme_ids']!=['scheme_05']
+            or source['seed']!=42 or source.get('data_policy')!='all_train'):
+        raise ValueError('The reused reference must be the declared 1024-question S-T/global/all/Slerp0.1 run')
+    revision=source_revision()[0]
+    name='matrix16_n1024_ST_L29_a0.1_'+revision[:10]+'_v1'
+    root=layout_paths({**source,'run_name':'ablation','param_name':name})['6']
+    binding=digest({'code':revision,'source_config_sha256':file_sha256(original/value['source_config']),
+        'axes':value['axes'],'global_source':'original_single','per_sample_source':'K4_seed42to45',
+        'mask':'bottom_half_native_teacher_positions_overlap_stable_v1','alpha':.1,'teacher_layer':29})
+    return {**value,'name':name,'root':root,'code_revision':revision,'acceptance_binding':binding,
+        'source_config_sha256':file_sha256(original/value['source_config']),
+        'acceptance_receipt':root+'/metadata/acceptance/passed.json',
+        'student_receipt':root+'/metadata/acceptance/student_passed.json','generation_shards':value.get('generation_shards',5)}
+
+
+def task_path(spec,name):return project(spec['root'])/'tasks'/name
+
+
+def birth(pid):
+    try:
+        proc=Path('/proc')/str(pid)
+        fields=(proc/'stat').read_text().rsplit(')',1)[1].split()
+        if fields[0]=='Z' or (proc/'cwd').resolve()!=ROOT:return None
+        return int(fields[19])
+    except (OSError,ValueError):return None
+
+
+class AdoptedWorker:
+    def __init__(self,record,result):self.pid=record['pid'];self.start=record['start_ticks'];self.result=result
+    def poll(self):
+        if birth(self.pid)==self.start:return None
+        return 0 if self.result.is_file() else 1
+    def terminate(self):
+        if birth(self.pid)==self.start:os.kill(self.pid,signal.SIGTERM)
+    def kill(self):
+        if birth(self.pid)==self.start:os.kill(self.pid,signal.SIGKILL)
+    def wait(self,timeout):
+        deadline=time.monotonic()+timeout
+        while self.poll() is None:
+            if time.monotonic()>deadline:raise subprocess.TimeoutExpired('adopted matrix worker',timeout)
+            time.sleep(.2)
+        return self.poll()
+
+
+def admission(spec,name,count,command):
+    from run_on_idle_gpus import tee_process
+    attempt=task_path(spec,name)/'admission'/str(time.time_ns())
+    env={**child_environment(command[0]),'STEER_OPD_MATRIX16_PARALLEL':'1',
+         'STEER_OPD_GPU_IDS':','.join(map(str,spec['allowed_gpu_pool'])),
+         'STEER_OPD_METRIC_WORKERS':'16'}
+    launch=[sys.executable,'scripts/run_on_idle_gpus.py','--count',str(count),
