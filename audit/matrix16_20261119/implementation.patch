+"""Shared banks and frozen scoring sources for the authorized 16-case S-T study."""
+from copy import deepcopy
+import csv
+from pathlib import Path
+
+import torch
+
+from steer_opd.artifact_reuse import StageArtifacts, verify_commit
+from steer_opd.compass_campaign import frozen_json, make_base_job, prepare_all_training_job
+from steer_opd.compass_job import load_codecs, model_path
+from steer_opd.checkpoint_identity import checkpoint_content_id
+from steer_opd.direction_bank import file_sha256
+from steer_opd.experiment_runtime import StageCheckpoint
+from steer_opd.matrix_masks import POLICY as MASK_POLICY
+from steer_opd.method_config import DIRECTION_VERSION, TEACHER_DIRECTION_VERSION
+from steer_opd.resumable_core import ROOT, atomic_json, digest, read_json
+from steer_opd.stage_campaign import Campaign, write_summary
+from steer_opd.stage_io import configure_layout, metadata_dir, component_target, project
+from steer_opd.stage_contracts import student_sv, runtime_key
+from steer_opd.sv_rollouts import VERSION, POLICY, requests_for, validate_records
+
+PROTOCOL='st_2x2x2x2_v1'
+GROUPS=[(g,c) for g in ('global','per_sample') for c in ('2048','full')]
+
+
+def cases():
+    return [{'id':f'{gran}_{context}_{gate}_{operator}','granularity':gran,'context':context,
+        'gate':gate,'operator':operator,
+        'reuse_reference':(gran,context,gate,operator)==('global','2048','all','slerp')}
+        for gran,context in GROUPS for gate in ('all','bottom_half') for operator in ('additive','slerp')]
+
+
+def group_config(spec,granularity,context,*,bank_only=False):
+    cfg=deepcopy(read_json(project(spec['source_config'])))
+    cfg.pop('student_baseline_run',None)
+    for name in ('teacher_text_reuse','source_rollout_reuse','candidate_tensor_compression'):
+        cfg.pop(name,None)
+    k4=granularity=='per_sample'
+    cfg.update(param_name=f"{spec['name']}_{granularity}_{context}"+('_banks' if bank_only else ''),
+        experiment='ablation',run_name='ablation',phase='overlap',optimizer_updates=0,automatic_opd=False,
+        data_policy='all_train',include_teacher_ablation=True,teacher_only_extraction=True,
+        direction='S-T',direction_version=VERSION if k4 else TEACHER_DIRECTION_VERSION,
+        teacher_direction_version=VERSION if k4 else TEACHER_DIRECTION_VERSION,
+        sv_rollout_count=4 if k4 else 1,sv_seed_policy=POLICY,
+        sv_max_context_len=2048 if context=='2048' else None,
+        teacher_layers=[29],alpha=.1,operator='slerp',strength_policies=['fixed'],
+        matrix_protocol=PROTOCOL,max_project_gpus=len(spec['allowed_gpu_pool']),
+        gpu_wait_seconds=86400,scoring_source_config=spec['source_config'],
+        execution_hold=None,execution_blockers=[],candidate_tensor_format='parquet_zstd',
+        retention_policy='minimal_v1',gate_metric='overlap',gate_target_rate=.5,
+        gpu_acceptance_receipt=spec['acceptance_receipt'],gpu_acceptance_binding=spec['acceptance_binding'])
+    cfg=configure_layout(cfg)
+    internal='per_question' if k4 else 'global'
+    cfg['matrix_conditions']=[{'id':case['id'],'direction':'S-T','steer_role':'teacher',
+        'gate':'all' if case['gate']=='all' else 'static_overlap','granularity':internal,
+        'bank':f'S-T_{internal}','operator':case['operator'],'alpha':.1,'layers':[29],
+        'direction_version':VERSION if k4 else TEACHER_DIRECTION_VERSION,'strength_policy':'fixed',
+        **({'additive_scaling':'raw_mean_difference_v1'} if case['operator']=='additive' else {})}
+        for case in cases() if case['granularity']==granularity and case['context']==context and not case['reuse_reference']]
+    return cfg
+
+
+def upstream(cfg,name):
+    ref=read_json(project(metadata_dir(cfg))/'upstreams'/f'{name}.json')
+    if file_sha256(project(ref['descriptor']))!=ref['descriptor_sha256']:
+        raise ValueError(f'Frozen {name} descriptor changed')
+    found=StageArtifacts(cfg).validate(ref['descriptor'])
+    if found[1]['artifact_id']!=ref['artifact_id'] or found[1]['owner']!=ref['owner']:
+        raise ValueError('Frozen upstream owner or artifact ID changed')
+    return found
+
+
+def campaign_sources(campaign,spec):
+    source=read_json(project(spec['source_config']))
+    campaign.remember('data',upstream(source,'data'))
+    questions=read_json(project(campaign.cfg['data_dir'])/'questions.json')
+    if len(questions)!=1024:raise ValueError('The matrix fixes all 1024 questions')
+    for role in ('teacher','student'):campaign.generation(role,questions)
+    return questions
+
+
+def prepare_banks(spec,granularity,context,progress,gpu,cpu):
+    cfg=group_config(spec,granularity,context,bank_only=True)
+    campaign=Campaign(cfg,progress,gpu,cpu)
+    questions=campaign_sources(campaign,spec)
+    campaign.directions(questions)
+    packet=campaign.records['bank_teacher']
+    return {'descriptor':packet['descriptor_path'],'descriptor_sha256':file_sha256(project(packet['descriptor_path'])),
+            'artifact_id':packet['artifact_id'],'owner':packet['owner']}
+
+
+def score_group(spec,granularity,context,bank_reference,progress,gpu,cpu):
+    cfg=group_config(spec,granularity,context)
+    campaign=Campaign(cfg,progress,gpu,cpu)
+    questions=campaign_sources(campaign,spec)
+    if file_sha256(project(bank_reference['descriptor']))!=bank_reference['descriptor_sha256']:
+        raise ValueError('Prepared direction bank descriptor changed')
+    found=campaign.store.validate(bank_reference['descriptor'])
+    if found[1]['artifact_id']!=bank_reference['artifact_id']:raise ValueError('Prepared bank identity changed')
+    folder=campaign.remember('bank_teacher',found)
+    bank=torch.load(folder/('S-T_per_question.pt' if granularity=='per_sample' else 'S-T_global.pt'),
+                    weights_only=True,map_location='cpu')
+    if bank['method']['direction']!='S-T' or bank['identity']['checkpoint']!=cfg['teacher']:
+        raise ValueError('This matrix injects teacher-space S-T only')
+    if granularity=='per_sample' and bank['identity'].get('sv_rollout_count')!=4:
+        raise ValueError('Per-sample scoring cannot omit its four-rollout extraction')
+    common=read_json(project(spec['root'])/'metadata/common_questions.json')['ids']
+    if not set(common).issubset(bank['valid_ids']):raise ValueError('Frozen common questions lost their direction vectors')
+    campaign.cfg['allowed_question_ids']=common
+    source=read_json(project(spec['source_config']))
+    for name in ('alignment','native_teacher','source_metrics'):
+        campaign.remember(name,upstream(source,name))
+    rows=[read_json(project(campaign.cfg['stage_inputs']['student'])/(q['id']+'_0.json')) for q in questions]
+    rowfile=project(cfg['run_dir'])/'source_rows.json';frozen_json(rowfile,rows)
+    base=make_base_job(campaign.cfg,campaign.codecs,str(rowfile.relative_to(ROOT)))
+    base.update(alignment_source_dir=campaign.cfg['stage_inputs']['alignment'])
+    job=prepare_all_training_job(campaign.cfg,base,campaign.codecs)
+    _,reference=upstream(source,'screen_train_teacher')
+    drift=project(reference['owner'])/'teacher_repeat_drift.json'
+    baseline=project(reference['owner'])/'baseline'
+    job.update(mask_policy=MASK_POLICY,teacher_drift_reference={'path':str(drift.relative_to(ROOT)),
+                                                             'sha256':file_sha256(drift)},
+        baseline_reference={'path':str(baseline.relative_to(ROOT)),
+                            'complete_sha256':file_sha256(baseline/'complete.json')})
+    summaries=campaign.screen(job,'train')
+    write_summary(cfg,{'train':summaries},campaign.records)
+    return {'summary':str((project(cfg['step_dirs']['6'])/'summaries.json').relative_to(ROOT)),
+            'summaries':summaries,'source_rows':len(rows),'new_scoring_rows_per_question':1,
+            'unsteered_teacher_rerun':False}
+
+
+def generation_job(spec,shard,shards):
+    from steer_opd.compass_campaign import generation_job as single_job
+    from steer_opd.math_data import prompt_ids
+    source=read_json(project(spec['source_config']));folder,_=upstream(source,'data')
+    questions=read_json(folder/'questions.json')
+    subset=questions[shard::shards]
+    codec=load_codecs(source)['student']
+    cfg={**source,'gpu_acceptance_receipt':spec['student_receipt'],
+         'gpu_acceptance_binding':spec['acceptance_binding'],'execution_hold':None,'execution_blockers':[]}
+    job=single_job(cfg,codec,'student',subset)
+    job.update(output=spec['root']+f'/extraction_shards/{shard}',purpose='sv_extraction_only',
+        request_seed_policy=POLICY,max_tokens=source['source_max_tokens'],temperature=1.,top_p=1.,
+        requests=requests_for(subset,lambda q:prompt_ids(codec.tokenizer,q['question'],source['enable_thinking'])))
+    return job
+
+
+def assemble_extraction(spec,shards):
+    source=read_json(project(spec['source_config']));folder,_=upstream(source,'data')
+    questions=read_json(folder/'questions.json');codecs=load_codecs(source)
+    from steer_opd.math_data import prompt_ids
+    requests=requests_for(questions,lambda q:prompt_ids(codecs['student'].tokenizer,q['question'],source['enable_thinking']))
+    records={};parents={}
+    for shard in range(shards):
+        path=project(spec['root'])/'extraction_shards'/str(shard)
+        verify_commit(path)
+        job=read_json(path/'job.json')['job']
+        values=[read_json(path/(r['key']+'.json')) for r in job['requests']]
+        validate_records(job['requests'],values,model=source['student'])
+        for row in values:
+            if row['key'] in records:raise ValueError('Duplicate assembled extraction slot')
+            records[row['key']]=row
+        parents[str(shard)]={'complete_sha256':file_sha256(path/'complete.json'),'job_sha256':digest(job)}
+    ordered=[records[r['key']] for r in requests]
+    content=checkpoint_content_id(model_path(source['student']))
+    audit=validate_records(requests,ordered,model=source['student'],content_id=content)
+    cfg=group_config(spec,'per_sample','2048',bank_only=True)
+    target=project(component_target(cfg,'student_sv'));target.mkdir(parents=True,exist_ok=True)
+    science=student_sv(cfg,questions,codecs['student'],content,runtime_key(ROOT/cfg['engine_python']))
+    saved=StageArtifacts(cfg).find('student_sv',science,target)
+    if saved:return {'descriptor':saved[1]['descriptor_path'],'artifact_id':saved[1]['artifact_id']}
+    files=[]
+    for row in ordered:
+        file=target/(row['key']+'.json');atomic_json(file,row);files.append(file)
+    job=generation_job(spec,0,1)
+    job.update(output=str(target.relative_to(ROOT)),requests=requests,shard_commits=parents)
+    atomic_json(target/'job.json',{'job':job,'hash':digest(job)})
+    atomic_json(target/'rollout_seeds.json',audit)
+    files += [target/'job.json',target/'rollout_seeds.json']
+    StageCheckpoint(target,digest({'science':science,'shards':parents})).commit(files,requests=len(requests),questions=1024)
+    _,packet=StageArtifacts(cfg).publish('student_sv',science,target)
+    return {'descriptor':packet['descriptor_path'],'artifact_id':packet['artifact_id']}
+
+
+def matrix_summary(spec,task_results):
+    rows=[];reference=None
+    source=read_json(project(spec['source_config']))
+    try:
+        owner,_=upstream(source,'screen_train_teacher')
+        reference=read_json(owner/'summaries.json')['scheme_05']
+        subset=project(spec['root'])/'metadata/reference_common_summary.json'
+        if subset.exists():reference=read_json(subset)
+    except FileNotFoundError:pass
+    for case in cases():
+        result=reference if case['reuse_reference'] else task_results.get(f"score_{case['granularity']}_{case['context']}",{}).get('summaries',{}).get(case['id'])
+        for metric in ('overlap','P_overlap'):
+            value=result['metrics'][metric] if result else {}
+            rows.append({**case,'metric':metric,'status':'reused' if result and case['reuse_reference'] else 'complete' if result else 'pending',
+                'value':value.get('question_weighted_value'),'delta_pp':value.get('question_weighted_delta_pp'),
+                'token_value':value.get('token_weighted_value',value.get('token_weighted_overlap16')),
+                'token_delta_pp':value.get('token_weighted_delta_pp'),'questions':value.get('questions'),
+                'positions':value.get('positions'),'valid_position_fraction':value.get('valid_position_fraction'),
+                'actual_steering_rate':value.get('actual_steering_rate')})
+    root=project(spec['root']);root.mkdir(parents=True,exist_ok=True)
+    file=root/'comparison.csv';tmp=file.with_suffix('.csv.tmp')
+    with tmp.open('w',newline='') as stream:
+        writer=csv.DictWriter(stream,fieldnames=list(rows[0]));writer.writeheader();writer.writerows(rows)
+    tmp.replace(file)
+    atomic_json(root/'results.json',{'cases':16,'unsteered':'reused_only','reference':'reused_only','rows':rows,
+        'source_config':spec['source_config'],'group_artifacts':task_results})
+    lines=['# S−T 16组消融','',
