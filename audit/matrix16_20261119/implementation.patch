+"""Verified immutable aliases of completed source artifacts in an isolated checkout."""
+import os
+from pathlib import Path
+import shutil
+
+from steer_opd.direction_bank import file_sha256
+from steer_opd.resumable_core import ROOT, atomic_json, read_json
+
+COMPONENTS=('data','teacher','student','alignment','native_teacher','source_metrics','bank_teacher','screen_train_teacher')
+
+
+class SourceBridge:
+    def __init__(self, original_root, source_config):
+        self.original=Path(original_root).resolve()
+        if not ROOT.resolve().is_relative_to(self.original):
+            raise ValueError('The isolated checkout must remain inside the authorized project')
+        self.config_relative=Path(source_config)
+        self.done={}
+
+    def source(self, relative):
+        relative=Path(relative)
+        if relative.is_absolute() or '..' in relative.parts or relative.parts[:1]==('output_remote',):
+            raise ValueError('Only explicit local completed artifacts may be imported')
+        path=self.original/relative
+        if not path.resolve().is_relative_to(self.original):raise ValueError('Original artifact escapes its project')
+        return path
+
+    def copy(self, relative, *, sha=None):
+        source=self.source(relative);target=ROOT/relative
+        expected=sha or file_sha256(source)
+        if target.exists():
+            if file_sha256(target)!=expected:raise ValueError(f'Immutable source alias changed: {target}')
+            return target
+        if file_sha256(source)!=expected:raise ValueError(f'Original source checksum changed: {source}')
+        target.parent.mkdir(parents=True,exist_ok=True)
+        temporary=target.with_name(target.name+f'.import.{os.getpid()}')
+        # Large committed tensors share storage; metadata is copied byte-for-byte.
+        # Neither these immutable aliases nor the original owner are ever edited.
+        if source.suffix in ('.pt','.gz','.parquet','.npz'):os.link(source,temporary)
+        else:shutil.copy2(source,temporary)
+        os.replace(temporary,target)
+        return target
+
+    def poll(self):
+        config=self.copy(self.config_relative)
+        cfg=read_json(config)
+        meta=Path(cfg['run_dir'])/'metadata'
+        for name in COMPONENTS:
+            ref_path=meta/'upstreams'/f'{name}.json'
+            if not self.source(ref_path).is_file():continue
+            upstream=read_json(self.source(ref_path))
+            if self.done.get(name)==upstream:continue
+            descriptor=self.source(upstream['descriptor'])
+            if file_sha256(descriptor)!=upstream['descriptor_sha256']:
+                raise ValueError('Original upstream descriptor changed')
+            packet=read_json(descriptor);owner=Path(packet['owner'])
+            if (packet['component']!=name or packet['artifact_id']!=upstream['artifact_id']
+                    or packet['owner']!=upstream['owner']):raise ValueError('Original upstream identity changed')
+            if packet.get('external_snapshot'):raise ValueError('This bridge expects current native commits')
+            complete=owner/'complete.json'
+            if file_sha256(self.source(complete))!=packet['complete_sha256']:
+                raise ValueError('Original engine-call completion changed')
+            for filename,item in packet['files'].items():
+                path=self.source(owner/filename)
+                if path.stat().st_size!=item['bytes']:raise ValueError('Original artifact size changed')
+                self.copy(owner/filename,sha=item['sha256'])
+                if Path(filename).name=='complete.json':
+                    stage_input=(owner/filename).with_name('stage_input.json')
+                    if self.source(stage_input).is_file():self.copy(stage_input)
+            self.copy(complete,sha=packet['complete_sha256'])
+            for filename in ('stage_input.json','reproducibility.json'):
+                if self.source(owner/filename).is_file():self.copy(owner/filename)
+            self.copy(upstream['descriptor'],sha=upstream['descriptor_sha256'])
+            self.copy(ref_path)
+            self.done[name]=upstream
+        atomic_json(ROOT/'.runtime/matrix16/source_aliases.json',{'original_root':str(self.original),
+            'source_config':str(self.config_relative),'components':self.done,
+            'large_tensor_storage':'immutable_hardlink_aliases','original_bytes_modified':False})
+        return self.done
