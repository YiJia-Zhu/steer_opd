+#!/usr/bin/env python3
+"""Generate a committed K4 extraction batch; never replace the scoring rollout."""
+import argparse
+
+from steer_opd.compass_job import load_codecs, model_path, project_path
+from steer_opd.checkpoint_identity import checkpoint_content_id
+from steer_opd.easysteer_static import create_engine
+from steer_opd.execution_policy import require_execution_allowed, require_default_scheduler_options
+from steer_opd.experiment_runtime import initialize_stage, Progress, StageCheckpoint, compute_required
+from steer_opd.resumable_core import atomic_json, digest, read_json
+from steer_opd.sv_rollouts import POLICY, sampling_params, validate_records, validate_requests
+
+
+def generate(job):
+    require_execution_allowed(job)
+    require_default_scheduler_options(job)
+    if (job.get('role') != 'student' or job.get('purpose') != 'sv_extraction_only'
+            or job.get('request_seed_policy') != POLICY or job.get('vector') is not None):
+        raise ValueError('Expected explicit unsteered K4 extraction job')
+    requests = job['requests']
+    validate_requests(requests)
+    output = project_path(job['output'])
+    content = checkpoint_content_id(model_path(job['model']), receipt_dir=output/'provenance/checkpoints')
+    effective = {**job, 'model_content_id': content}
+    runtime = initialize_stage(effective, output)
+    stage = StageCheckpoint(output, digest({'job': effective, 'runtime': runtime}))
+    with Progress(output, 'student_sv_four_rollouts', len(requests), show_bar=False) as progress:
+        if stage.load() is not None:
+            validate_records(requests, [read_json(output/(r['key']+'.json')) for r in requests],
+                             model=job['model'], content_id=content)
+            progress.resume(len(requests))
+            return
+        compute_required()
+        codec = load_codecs(job)['student']
+        engine = create_engine(model_path(job['model']), codec.support_size,
+            max_model_len=job['max_tokens']+max(len(r['prompt_token_ids']) for r in requests),
+            tensor_parallel_size=1, gpu_memory_utilization=job['gpu_memory_utilization'],
+            batch_invariant=True, prefix_caching=True, seed=42, progress=progress)
+        from vllm import SamplingParams
+        params = sampling_params({**job, 'stop_token_ids': sorted(codec.eos)}, requests, SamplingParams)
+        with progress.phase_scope('continuous_generation'):
+            outputs = engine.generate([{'prompt_token_ids': r['prompt_token_ids']} for r in requests],
+                params, steering=False, use_tqdm=progress.engine_tqdm)
+        if len(outputs) != len(requests):
+            raise RuntimeError('Incomplete extraction generation call')
+        progress.finished_call(len(requests))
+        rows = []
+        for request, param, response in zip(requests, params, outputs):
+            if list(response.prompt_token_ids) != request['prompt_token_ids'] or len(response.outputs) != 1:
+                raise ValueError('Extraction engine changed prompt order or n=1')
+            sample = response.outputs[0]
+            rows.append({**request, 'token_ids': list(sample.token_ids), 'text': sample.text,
+                'finish_reason': sample.finish_reason, 'stop_reason': sample.stop_reason,
+                'model': job['model'], 'model_content_id': content, 'steering': False,
+                'seed_policy': POLICY, 'sampling_seed': param.seed, 'job_hash': digest(effective)})
+        audit = validate_records(requests, rows, model=job['model'], content_id=content)
+        atomic_json(output/'job.json', {'job': effective, 'hash': digest(effective)})
+        atomic_json(output/'rollout_seeds.json', audit)
+        files = [output/'job.json', output/'rollout_seeds.json']
+        for row in rows:
+            path = output/(row['key']+'.json')
+            atomic_json(path, row)
+            files.append(path)
+        stage.commit(files, requests=len(rows), questions=audit['question_count'], seed_policy=POLICY)
+        progress.mark_committed(len(rows))
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--job', required=True)
+    generate(read_json(parser.parse_args().job))
