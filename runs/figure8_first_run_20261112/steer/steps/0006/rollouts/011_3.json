  "text": "import math\nimport cmath\n\ndef triangle_area(a, b, c, x1, y1, x2, y2, x3, y3):\n    # Equation of the line ABC\n    coeffs_a, coeffs_b, coeffs_c = -2 * a, 2 * b, 2 * c\n    coeffs_x1, coeffs_y1, coeffs_x2, coeffs_y2 = -coeffs_c, coeffs_b, coeffs_a, coeffs_c\n    coeffs_x3, coeffs_y3, coeffs_x4, coeffs_y4 = -coeffs_a, coeffs_c, coeffs_b, coeffs_a\n    \n    discriminant = coeffs_x1 * coeffs_y2 - coeffs_y1 * coeffs_x2 + coeffs_x3 * coeffs_y4 - coeffs_y3 * coeffs_x4 - coeffs_x1 * coeffs_y4 + coeffs_y1 * coeffs_x4\n    \n    a2 = x2**2 * discriminant\n    b2 = y1 * y2 * discriminant\n    c2 = x1**2 * discriminant\n    area_squared = 4 * a2 + 4 * b2 + 4 * c2\n    \n    area = math.sqrt(area_squared / 16)\n    return area\n\ndef distance(x1, y1, x2, y2):\n    return math.sqrt((x2 - x1)**2 + (y2 - y1)**2)\n\ndef closest_point(A, B, C, X):\n    # Calculate the distance from A to line BC\n    coeffs_a, coeffs_b, coeffs_c = -2 * B[0], 2 * C[0], 2 * C[1] - 2 * B[1]\n    coeffs_x1, coeffs_y1, coeffs_x2, coeffs_y2 = A[0] - coeffs_c, B[1], A[0], C[1]\n    \n    x, y = coeffs_a, coeffs_b / coeffs_a\n    \n    conditions =  coeffs_x1 + coeffs_x2 + coeffs_x3 == coeffs_y1 + coeffs_y2 + coeffs_y3\n    linear_eq1 = abs(coeffs_a) * x + abs(coeffs_b) * y - 1\n    linear_eq2 = abs(coeffs_a) * x + abs(coeffs_b) * y + 1\n    \n    islinear = (coeffs_a > 0 and max(linear_eq1, linear_eq2) > 0 and min(linear_eq1, linear_eq2) < 0)\n    isxlinear = (coeffs_a > 0 and abs(coeffs_a) * x + abs(coeffs_b) * y >= 0)\n    risylinear = (coeffs_a < 0 and abs(coeffs_a) * x + abs(coeffs_b) * y <= 0)\n    \n    if islinear:\n        conditions =  coeffs_x1 + coeffs_x2 + coeffs_x3 == coeffs_y1 + coeffs_y2 + coeffs_y3\n        linear_eq1 = abs(coeffs_a) * x + abs(coeffs_b) * y - 1\n        linear_eq2 = abs(coeffs_a) * x + abs(coeffs_b) * y + 1\n        \n        if (not (islinear or (linear_eq1 > 0 and linear_eq2 < 0))) and not ((isxlinear): \n            if (not (islinear and isxlinear) or (not (risylinear and linear_eq2 > 0))):\ndef scale(x, y, scale_factor):\n    return x * scale_factor, y * scale_factor\n\nfrom cmath import sqrt, exp\n\ndef rotate(x, y, angle=radians(225)):\n    cos_angle = cos(angle)\n    sin_angle = sin(angle)\n    return x * cos_angle - y * sin_angle, x * sin_angle + y * cos_angle\n\ndef absolute_value(a, b):\n    angle = atan2(a, b)\n    radius = sqrt(abs(a ** 2 + b ** 2))\n    return radius, angle\n\nTriangle = (math.sqrt(13 ** 2 + 14 ** 2 - 2 * 13 * 14 * cos(radians(15))))\r!=",
