+def completed_baseline(plan):
+    from steer_opd.training.retention import recover_checkpoint
+    root = ROOT / plan['output']
+    step = plan['settings']['total_steps']
+    checkpoints = root / 'checkpoints'
+    pointer = checkpoints / 'latest_complete.json'
+    frozen = root / 'metadata/plan.json'
+    if frozen.exists() and read_json(frozen) != plan:
+        raise ValueError('Use a new training run name; prepared plan is immutable')
+    if not pointer.is_file() or read_json(pointer)['step'] != step:
+        return False
+    if not frozen.is_file():
+        raise ValueError('Final baseline checkpoint has no frozen plan')
+    evaluation = root / f'evaluation/metrics/step_{step}.json'
+    if not evaluation.is_file():
+        return False
+    scores = read_json(evaluation)
+    for benchmark in plan['evaluation']['counts']:
+        accuracy = scores.get(f'eval/{benchmark}/acc')
+        if type(accuracy) not in (int, float) or not 0 <= accuracy <= 1:
+            return False
+    if plan.get('evaluation_response_format'):
+        from steer_opd.evaluation_text import responses_complete
+        if not responses_complete(root, step):
+            return False
+    return recover_checkpoint(checkpoints, plan) == checkpoints / f'global_step_{step}'
 
 
