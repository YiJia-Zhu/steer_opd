+def use_frozen_runtime(path):
+    """Resume an existing run with the implementation recorded when it was prepared."""
+    path = Path(path)
+    if not path.is_file():
+        return
+    frozen = read_json(path)
+    suffix = Path('src/steer_opd/training/verl_entry.py')
+    entries = [name for name in frozen['implementation_sha256'] if Path(name).parts[-4:] == suffix.parts]
+    if len(entries) != 1:
+        raise ValueError('Prepared plan must identify one training entry point')
+    entry = (ROOT / entries[0]).resolve()
+    if entry == Path(__file__).resolve():
+        return
+    src = entry.parents[2]
+    if src != ROOT/'src' and not (src.name == 'src' and src.parent.parent in
+                                  (ROOT/'.runtime/training', ROOT/'.runtime/baselines')):
+        raise ValueError('Unrecognized frozen training source')
+    if (frozen['binding'] != digest({k:v for k,v in frozen.items() if k != 'binding'})
+            or hashlib.sha256(entry.read_bytes()).hexdigest() != frozen['implementation_sha256'][entries[0]]):
+        raise ValueError('Frozen training plan or entry point changed')
+    if not (src / 'steer_opd/__init__.py').is_file():
+        raise FileNotFoundError(f'Frozen training package source links do not resolve: {src}')
+    env = {**os.environ, 'PYTHONPATH': os.pathsep.join([str(src), os.environ.get('PYTHONPATH','')])}
+    os.execve(sys.executable, [sys.executable, '-m', 'steer_opd.training.verl_entry', *sys.argv[1:]], env)
+
